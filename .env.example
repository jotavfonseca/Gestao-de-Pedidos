# Copie para .env:  cp .env.example .env
# Evite o caractere "$" nas senhas (o Docker Compose o interpreta).

# ---------- PostgreSQL ----------
POSTGRES_DB=ordersdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ---------- pgAdmin (http://localhost:8080) ----------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=8080

# ---------- Azure Service Bus ----------
# Emulador local (padrão). Ao usar o emulador você aceita as licenças do
# Azure Service Bus Emulator e do SQL Server (ACCEPT_EULA=Y).
ACCEPT_EULA=Y
# Senha do SQL Server usado pelo emulador (mín. 8 caracteres, com maiúscula, minúscula, número e símbolo)
MSSQL_SA_PASSWORD=Orders_Passw0rd!
# Para usar um namespace real do Azure, troque pela connection string dele
# (as filas order-created e order-status-changed precisam existir).
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://servicebus;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;

# ---------- API / Worker ----------
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
API_PORT=5000
# Tempo entre Processando e Finalizado (desafio: 5 s)
WORKER_PROCESSING_DELAY_SECONDS=5

# ---------- Frontend (http://localhost:3000) ----------
FRONTEND_PORT=3000

# ---------- Tracing (Jaeger em http://localhost:16686) ----------
JAEGER_UI_PORT=16686

# ---------- Módulo IA (opcional) ----------
# Sem a chave, a tela "Pergunte" mostra que o módulo está desativado.
ANTHROPIC_API_KEY=
