# Copy to .env:  cp .env.example .env
# Avoid the "$" character in passwords (Docker Compose interpolates it).

# ---------- PostgreSQL ----------
POSTGRES_DB=ordersdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ---------- pgAdmin (http://localhost:8080) ----------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=8080

# ---------- Azure Service Bus ----------
# Local emulator (default). By using the emulator you accept the licenses of
# the Azure Service Bus Emulator and SQL Server (ACCEPT_EULA=Y).
ACCEPT_EULA=Y
# SQL Server password used by the emulator (8+ characters with upper case, lower case, a digit and a symbol)
MSSQL_SA_PASSWORD=Orders_Passw0rd!
# To use a real Azure namespace, replace this with its connection string
# (the order-created and order-status-changed queues must exist).
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://servicebus;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;

# ---------- API / Worker ----------
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
API_PORT=5000
# Time between Processing and Completed (challenge: 5 s)
WORKER_PROCESSING_DELAY_SECONDS=5

# ---------- Frontend (http://localhost:3000) ----------
FRONTEND_PORT=3000

# ---------- Tracing (Jaeger at http://localhost:16686) ----------
JAEGER_UI_PORT=16686

# ---------- AI module (optional) ----------
# Without a key, the "Ask" page shows that the module is disabled.
ANTHROPIC_API_KEY=
